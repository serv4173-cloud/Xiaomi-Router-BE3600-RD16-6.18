#!/bin/sh /etc/rc.common
# DRAFT, not tested. Mark the running slot (rootfs_1, OpenWrt) good once LAN is up (Xiaomi RD16 only).
START=99

start() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "xiaomi,rd16" ] || return 0
	(
		for _ in $(seq 1 24); do
			ubus call network.interface.lan status 2>/dev/null |
				grep -q '"up": true' && break
			sleep 5
		done
		if ubus call network.interface.lan status 2>/dev/null | grep -q '"up": true'; then
			/usr/sbin/rd16-slot mark-good 2>&1 | logger -t rd16-slot
		else
			logger -p daemon.err -t rd16-slot "LAN not up after 120 s; slot NOT marked good"
		fi
	) &
}
